{
    "name": "Strivio Dark Premium",
    "version": "1.0.0",
    "description": "A high-end, dark-mode centric design system for digital marketplaces.",
    "theme": {
        "colors": {
            "background": {
                "default": "#030304",
                "surface": "#0C0C0E",
                "surface_hover": "#161619",
                "surface_active": "#1F1F23",
                "overlay": "rgba(3, 3, 4, 0.8)"
            },
            "text": {
                "primary": "#EDEDEF",
                "secondary": "#A0A0A9",
                "tertiary": "#71717A",
                "disabled": "#3F3F46",
                "inverse": "#030304"
            },
            "brand": {
                "primary": "#6366F1",
                "primary_hover": "#818CF8",
                "primary_foreground": "#FFFFFF",
                "secondary": "#EC4899",
                "secondary_hover": "#F472B6",
                "accent": "#8B5CF6"
            },
            "status": {
                "success": "#10B981",
                "warning": "#F59E0B",
                "error": "#EF4444",
                "info": "#3B82F6"
            },
            "border": {
                "default": "#27272A",
                "hover": "#3F3F46",
                "focus": "#6366F1"
