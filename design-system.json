            "glow_primary": "0 0 20px 0 rgba(99, 102, 241, 0.15)",
            "glow_hover": "0 0 30px 5px rgba(99, 102, 241, 0.25)"
        },
        "opacity": {
            "0": "0",
            "5": "0.05",
            "10": "0.1",
            "20": "0.2",
            "25": "0.25",
            "30": "0.3",
            "40": "0.4",
            "50": "0.5",
            "60": "0.6",
            "70": "0.7",
            "75": "0.75",
            "80": "0.8",
            "90": "0.9",
            "95": "0.95",
            "100": "1"
