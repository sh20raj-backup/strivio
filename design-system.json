                "4xl": "2.25rem",
                "5xl": "3rem",
                "6xl": "3.75rem"
            },
            "fontWeight": {
                "normal": 400,
                "medium": 500,
                "semibold": 600,
                "bold": 700
            },
            "lineHeight": {
                "tight": 1.25,
                "snug": 1.375,
                "normal": 1.5,
                "relaxed": 1.625,
                "loose": 2
